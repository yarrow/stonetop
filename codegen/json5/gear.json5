// Every gizmo, defined once: the gear sheet's mobile rows, the Inventory insert's two lists,
// and the contents of the playbooks' kits. Sections are in printed order. Immobile things,
// transport, livestock, followers, and Supplies (whose capacity depends on Prosperity) are
// left out.
//
// A gizmo's `name` is the bold head as printed; `qualifier` is the material or grade after it
// (iron, bronze, fine steel, boiled leather, parchment, fine vellum, fine); `piercing` is the
// starred upgrade on the gear sheet; `slots` counts the diamonds; `value` is the gear sheet's
// price band (nothing reads it yet); `description` is everything after the name as printed,
// qualifier and tags included. A run of circles becomes a `resource` with a `{resource}`
// placeholder where the run was.
{
  weaponsOfWar: [
    {
      name: "Mace or flail",
      qualifier: "iron",
      slots: 1,
      value: 1,
      description: ", iron (<em>close, forceful</em>)",
    },
    {
      name: "Battleaxe",
      qualifier: "iron",
      slots: 1,
      value: 1,
      description: ", iron (<em>close, messy</em>)",
    },
    {
      name: "Battleaxe",
      qualifier: "iron",
      piercing: 1,
      slots: 1,
      value: 2,
      description: ", iron (<em>close, messy</em>, 1 piercing)",
    },
    {
      name: "Battleaxe",
      qualifier: "iron",
      piercing: 2,
      slots: 1,
      value: 2,
      description: ", iron (<em>close, messy</em>, 2 piercing)",
    },
    {
      name: "Short sword",
      qualifier: "iron",
      slots: 1,
      value: 1,
      description: ", iron (<em>hand, close</em>)",
    },
    {
      name: "Short sword",
      qualifier: "iron",
      piercing: 1,
      slots: 1,
      value: 2,
      description: ", iron (<em>hand, close</em>, 1 piercing)",
    },
    {
      name: "Short sword",
      qualifier: "iron",
      piercing: 2,
      slots: 1,
      value: 2,
      description: ", iron (<em>hand, close</em>, 2 piercing)",
    },
    {
      name: "Sword",
      qualifier: "iron",
      slots: 1,
      value: 1,
      description: ", iron (<em>close</em>, +1 damage)",
    },
    {
      name: "Sword",
      qualifier: "iron",
      piercing: 1,
      slots: 1,
      value: 2,
      description: ", iron (<em>close</em>, +1 damage, 1 piercing)",
    },
    {
      name: "Sword",
      qualifier: "iron",
      piercing: 2,
      slots: 1,
      value: 2,
      description: ", iron (<em>close</em>, +1 damage, 2 piercing)",
    },
    {
      name: "Warhammer",
      qualifier: "iron",
      slots: 1,
      value: 1,
      description: ", iron (<em>close</em>, 2 piercing)",
    },
    {
      name: "Crossbow",
      slots: 1,
      value: 1,
      description: "(<em>far</em>, +1 damage, <em>reload</em>, x piercing; Bolts: {resource})",
      resource: { hold: "Bolts", canBe: ["all out", "low ammo", "plenty left"], start: "full" },
    },
    {
      name: "Composite bow",
      slots: 1,
      value: 1,
      description: "(<em>far</em>, +1 damage, x piercing; Arrows: {resource})",
      resource: { hold: "Arrows", canBe: ["all out", "low ammo", "plenty left"], start: "full" },
    },
  ],

